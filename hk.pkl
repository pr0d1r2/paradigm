amends "pkl/Config.pkl"

// Seeded by `pklith seed`; yours to edit. The steps come from hk.pklith.pkl,
// which `pklith gen` and `pklith lay` write from .pklith: shape them here
// (excludes, depends) by amending a step by its id.
import "hk.pklith.pkl" as generated

local all = (generated.steps) { ...generated.push }

hooks {
  ["pre-commit"] {
    // Check only, never stash (root V15): hk's git stash is shared by every
    // worktree of this repository, and parallel workers moved each other's
    // files through it. In hk 1.58 "patch-file" is an alias of "git", so the
    // only safe setting is none, and without a stash fixers would rewrite
    // unstaged edits; `hk fix` stays available by hand.
    fix = false
    stash = "none"
    steps = generated.steps
  }
  ["pre-push"] {
    steps = all
  }
  ["check"] {
    steps = all
  }
  ["fix"] {
    fix = true
    steps = all
  }
}
